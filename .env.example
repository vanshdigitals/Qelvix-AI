# Qelvix backend environment — the complete variable list from 03_BACKEND.md §11.
# Copy to backend/.env and fill in. Never commit a filled copy (INV-29).

# NVIDIA NIM (DeepSeek) — primary LLM
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
# Optional direct DeepSeek key (api.deepseek.com) as an alternative to NVIDIA NIM
DeepSeek_API_KEY=

# Google Gemini fallback (two-key chain). Uses model gemini-flash-latest.
# Legacy single key (still honored last):
GEMINI_API_KEY=your_gemini_api_key_here
# Preferred: primary is tried first, backup second.
GEMINI_PRIMARY_API_KEY=your_primary_gemini_api_key_here
FALLBACK_BACKUP_GEMINI_PRIMARY_API_KEY=your_backup_gemini_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://qelvix:qelvix@localhost:5432/qelvix
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=
PHISHTANK_API_KEY=
SECURITY_TRAILS_API_KEY=

# Notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
RESEND_API_KEY=

# App
SECRET_KEY=
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
