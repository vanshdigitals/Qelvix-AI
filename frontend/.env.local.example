# Frontend environment — 06_DEVELOPMENT_GUIDE.md §3.
# Copy to frontend/.env.local. Only NEXT_PUBLIC_* variables belong here; nothing
# secret is ever given this prefix, because the prefix is what ships to the browser.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only demo credentials for the auth autofill helper.
# Ignored entirely in production builds. Leave blank to hide the helper.
NEXT_PUBLIC_DEMO_EMAIL=demo@qelvix.ai
NEXT_PUBLIC_DEMO_PASSWORD=

# Set to "true" only once Google OAuth is configured in the Supabase dashboard.
# When false, the Google button renders in a disabled state instead of pretending to work.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Set true to expose dev-only form suggestion chips. Leave false/blank in production.
NEXT_PUBLIC_ENABLE_DEMO_HELPERS=false
